
import { useCallback, useEffect, useMemo, useState } from 'react';
import { Link } from 'react-router-dom';
import { useAuth } from '../../context/useAuth.js';
import { fetchAdminProducts } from '../../api/adminProductApi.js';
import {
  adjustInventoryStock,
  fetchInventory,
  fetchInventorySummary,
} from '../../api/inventoryApi.js';
import { resolveImageUrl } from '../../utils/imageUrl.js';
import {
  filterInventoryRows,
  getInventoryStatus,
  getProductAvailability,
  getProductImage,
  getProductStockTotal,
  INVENTORY_STATUS,
  INVENTORY_STATUS_LABELS,
  isProductActive,
  sortInventoryRows,
} from '../../utils/inventory.js';

import AdminPageHeader from '../../components/Admin/AdminPageHeader';
import AdminStatCard from '../../components/Admin/AdminStatCard';
import AdminDataTable from '../../components/Admin/AdminDataTable';
import AdminModal from '../../components/Admin/AdminModal';
import AdminStatusPill from '../../components/Admin/AdminStatusPill';

import './AdminInventory.css';

const PAGE_SIZE = 8;
const numberFormat = new Intl.NumberFormat('en-PH');

const dateFormat = new Intl.DateTimeFormat('en-PH', {
  dateStyle: 'medium',
  timeStyle: 'short',
});

function formatDate(value) {
  if (!value) return '—';
  const timestamp = Date.parse(value);
  return Number.isFinite(timestamp) ? dateFormat.format(timestamp) : '—';
}

export default function AdminInventory() {
  const { user } = useAuth();

  const [reloadKey, setReloadKey] = useState(0);
  const [catalog, setCatalog] = useState({ status: 'loading', products: [], error: '' });
  const [inventory, setInventory] = useState({ status: 'loading', records: [], error: '' });
  const [summary, setSummary] = useState({ status: 'loading', data: null, error: '' });

  const [search, setSearch] = useState('');
  const [category, setCategory] = useState('all');
  const [productStatus, setProductStatus] = useState('all');
  const [inventoryStatus, setInventoryStatus] = useState('all');
  const [sort, setSort] = useState('default');
  const [page, setPage] = useState(1);

  const [selectedProduct, setSelectedProduct] = useState(null);
  const [adjustingProduct, setAdjustingProduct] = useState(null);
  const [notice, setNotice] = useState(null);

  useEffect(() => {
    if (!user) return undefined;
    let cancelled = false;
    async function loadCatalog() {
      try {
        const products = await fetchAdminProducts(user);
        if (!cancelled) setCatalog({ status: 'ready', products, error: '' });
      } catch (error) {
        if (!cancelled) setCatalog({ status: 'error', products: [], error: error.message || 'Could not load products.' });
      }
    }
    loadCatalog();
    return () => { cancelled = true; };
  }, [user, reloadKey]);

  useEffect(() => {
    if (!user) return undefined;
    let cancelled = false;
    async function loadInventory() {
      try {
        const records = await fetchInventory(user);
        if (!cancelled) setInventory({ status: 'ready', records, error: '' });
      } catch (error) {
        if (!cancelled) setInventory({ status: 'error', records: [], error: error.message || 'Could not load inventory.' });
      }
    }
    loadInventory();
    return () => { cancelled = true; };
  }, [user, reloadKey]);

  useEffect(() => {
    if (!user) return undefined;
    let cancelled = false;
    async function loadSummary() {
      try {
        const data = await fetchInventorySummary(user);
        if (!cancelled) setSummary({ status: 'ready', data, error: '' });
      } catch (error) {
        if (!cancelled) setSummary({ status: 'error', data: null, error: error.message || 'Could not load summary.' });
      }
    }
    loadSummary();
    return () => { cancelled = true; };
  }, [user, reloadKey]);

  const reload = useCallback(() => {
    setCatalog((current) => ({ ...current, status: 'loading', error: '' }));
    setInventory((current) => ({ ...current, status: 'loading', error: '' }));
    setSummary((current) => ({ ...current, status: 'loading', error: '' }));
    setNotice(null);
    setReloadKey((value) => value + 1);
  }, []);

  const recordsByProduct = useMemo(() => {
    const map = new Map();
    for (const record of inventory.records) {
      const key = String(record.productId);
      if (!map.has(key)) map.set(key, []);
      map.get(key).push(record);
    }
    return map;
  }, [inventory.records]);

  const rows = useMemo(
    () => catalog.products.map((product) => ({
      product,
      records: recordsByProduct.get(String(product.id)) || [],
    })),
    [catalog.products, recordsByProduct],
  );

  const categories = useMemo(
    () => [...new Set(catalog.products.map((product) => product.category).filter(Boolean))].sort((a, b) => a.localeCompare(b)),
    [catalog.products],
  );

  const visibleRows = useMemo(
    () => sortInventoryRows(filterInventoryRows(rows, { search, category, productStatus, inventoryStatus }), sort),
    [rows, search, category, productStatus, inventoryStatus, sort],
  );

  const totalPages = Math.max(1, Math.ceil(visibleRows.length / PAGE_SIZE));
  const currentPage = Math.min(page, totalPages);
  const pageRows = visibleRows.slice((currentPage - 1) * PAGE_SIZE, currentPage * PAGE_SIZE);

  function updateFilter(setter, value) {
    setter(value);
    setPage(1);
  }

  function clearFilters() {
    setSearch('');
    setCategory('all');
    setProductStatus('all');
    setInventoryStatus('all');
    setSort('default');
    setPage(1);
  }

  const filtersActive = search.trim() !== '' || category !== 'all' || productStatus !== 'all' || inventoryStatus !== 'all';
  const inventoryReady = inventory.status === 'ready';

  const tableColumns = [
    { label: 'Product', className: 'col-product' },
    { label: 'Variants', className: 'col-variants' },
    { label: 'Available units', className: 'col-stock' },
    { label: 'Inventory status', className: 'col-inv-status' },
    { label: 'Product status', className: 'col-prod-status' },
    { label: 'Actions', className: 'col-actions' },
  ];

  const renderInventoryRow = ({ product, records }) => (
    <>
      <td>
        <div className="admin-product-cell">
          <span className="admin-product-thumb">
            {getProductImage(product) ? (
              <img src={resolveImageUrl(getProductImage(product))} alt="" loading="lazy" />
            ) : (
              <span>◇</span>
            )}
          </span>
          <div className="admin-product-info">
            <strong>{product.name}</strong>
            <small>{product.category || 'Uncategorized'}</small>
          </div>
        </div>
      </td>
      <td>{records.length}</td>
      <td><strong className="admin-stock-value">{numberFormat.format(getProductStockTotal(records))}</strong></td>
      <td>
        <div className="admin-inv-status-container">
          {records.length ? (
            <AdminStatusPill status={getInventoryStatus(records) === INVENTORY_STATUS.OUT_OF_STOCK ? 'Rejected' : getInventoryStatus(records) === INVENTORY_STATUS.LOW_STOCK ? 'Pending' : 'Verified'} />
          ) : (
            <span className="admin-status-pill-empty">No variants</span>
          )}
        </div>
      </td>
      <td>
        <div className="admin-product-status-group">
          <span className={`admin-listing-status ${isProductActive(product) ? 'active' : 'inactive'}`}>
            <span className="admin-status-dot" />
            {isProductActive(product) ? 'Active' : 'Inactive'}
          </span>
          <AdminStatusPill status={getProductAvailability(product) === 'pre-order' ? 'Processing' : 'Verified'} />
        </div>
      </td>
      <td>
        <div className="admin-row-actions">
          <button className="admin-btn admin-btn-ghost" onClick={() => setSelectedProduct(product)}>View</button>
          <button className="admin-btn admin-btn-ghost" onClick={() => setAdjustingProduct(product)}>Adjust stock</button>
        </div>
      </td>
    </>
  );

  return (
    <section className="admin-inventory">
      <AdminPageHeader
        eyebrow="STORE MANAGEMENT"
        title="Inventory"
        description="Manage stock for every product color and size."
        action={
          <div className="admin-header-actions">
            <button className="admin-btn admin-btn-secondary" onClick={reload} disabled={catalog.status === 'loading' || inventory.status === 'loading'}>Refresh</button>
            <Link to="/admin/products" className="admin-btn admin-btn-secondary">Manage products</Link>
          </div>
        }
      />

      {notice && (
        <div className="admin-action-notice" role={notice.type === 'error' ? 'alert' : 'status'}>
          <span className="admin-action-notice-text">{notice.message}</span>
          <button className="admin-btn admin-btn-ghost" onClick={() => setNotice(null)}>Dismiss</button>
        </div>
      )}

      {inventory.status === 'error' && (
        <div className="admin-action-notice admin-notice-error" role="alert">
          <p><strong>Inventory could not be loaded.</strong> {inventory.error}</p>
        </div>
      )}

      <div className="admin-summary-grid">
        <AdminStatCard label="Total products" value={catalog.status === 'ready' ? catalog.products.length : null} description="Products in the catalog" />
        <AdminStatCard label="Total available units" value={summary.data?.totalStockUnits} description="Available stock across variants" />
        <AdminStatCard label="Low stock products" value={summary.data?.lowStockProducts} description="Products at or below threshold" />
        <AdminStatCard label="Out of stock products" value={summary.data?.outOfStockProducts} description="Products with no available units" />
      </div>

      <section className="admin-catalog-panel">
        <div className="admin-catalog-header">
          <div className="admin-catalog-title-group">
            <h2 className="admin-catalog-title">Product inventory</h2>
            <p className="admin-catalog-description">Select a product to view and adjust its color-size stock.</p>
          </div>
          <span className="admin-result-count">
            {visibleRows.length}{" "}
            {visibleRows.length === 1 ? "product" : "products"}
          </span>
        </div>

        <div className="admin-toolbar">
          <div className="admin-search-box">
            <span className="admin-search-icon">⌕</span>
            <input
              type="search"
              value={search}
              onChange={(event) => updateFilter(setSearch, event.target.value)}
              placeholder="Search product, color, size or SKU..."
              aria-label="Search inventory"
            />
          </div>
          <div className="admin-filter-group">
            <label className="admin-filter">
              <span>Category</span>
              <select value={category} onChange={(event) => updateFilter(setCategory, event.target.value)}>{categories.map((item) => <option key={item} value={item}>{item}</option>)}</select>
            </label>
            <label className="admin-filter">
              <span>Product status</span>
              <select value={productStatus} onChange={(event) => updateFilter(setProductStatus, event.target.value)}>{['all', 'active', 'inactive', 'ready', 'pre-order'].map(s => <option key={s} value={s}>{s}</option>)}</select>
            </label>
            <label className="admin-filter">
              <span>Inventory status</span>
              <select value={inventoryStatus} onChange={(event) => updateFilter(setInventoryStatus, event.target.value)} disabled={!inventoryReady}>{['all', 'In stock', 'Low stock', 'Out of stock'].map(s => <option key={s} value={s}>{s}</option>)}</select>
            </label>
            <label className="admin-filter">
              <span>Sort by</span>
              <select value={sort} onChange={(event) => updateFilter(setSort, event.target.value)}>{['default', 'name-asc', 'name-desc', 'stock-asc', 'stock-desc'].map(s => <option key={s} value={s}>{s}</option>)}</select>
            </label>
          </div>
        </div>

        <AdminDataTable
          columns={tableColumns}
          data={pageRows}
          renderRow={renderInventoryRow}
          loadingState={catalog.status === 'loading' || inventory.status === 'loading' ? "Loading product inventory..." : null}
          errorState={catalog.status === 'error' || inventory.status === 'error' ? "Inventory is not ready. Resolve the error above, then refresh this page." : null}
          emptyState={
            <div className="admin-table-empty-content">
              <span className="admin-empty-icon">▦</span>
              <strong>No products found</strong>
              <p>Try changing your search or filters.</p>
              {filtersActive && (
                <button className="admin-btn admin-btn-secondary" onClick={clearFilters}>Clear filters</button>
              )}
            </div>
          }
        />

        <div className="admin-pagination">
          <span className="admin-pagination-info">
            Showing {(currentPage - 1) * PAGE_SIZE + 1}–{Math.min(currentPage * PAGE_SIZE, visibleRows.length)} of {visibleRows.length}
          </span>
          <div className="admin-pagination-controls">
            <button className="admin-btn admin-btn-ghost" disabled={currentPage === 1} onClick={() => setPage((v) => Math.max(1, v - 1))}>Previous</button>
            <span className="admin-pagination-current">Page {currentPage} of {totalPages}</span>
            <button className="admin-btn admin-btn-ghost" disabled={currentPage === totalPages} onClick={() => setPage((v) => Math.min(totalPages, v + 1))}>Next</button>
          </div>
        </div>
      </section>

      {selectedProduct && (
        <InventoryDetails
          product={selectedProduct}
          records={recordsByProduct.get(String(selectedProduct.id)) || []}
          onClose={() => setSelectedProduct(null)}
          onAdjust={() => {
            setAdjustingProduct(selectedProduct);
            setSelectedProduct(null);
          }}
        />
      )}

      {adjustingProduct && (
        <StockAdjustmentModal
          product={adjustingProduct}
          records={recordsByProduct.get(String(adjustingProduct.id)) || []}
          user={user}
          onClose={() => setAdjustingProduct(null)}
          onSaved={() => {
            setAdjustingProduct(null);
            setNotice({ type: 'success', message: 'Stock adjustment saved successfully.' });
            reload();
          }}
          onError={(message) => setNotice({ type: 'error', message })}
        />
      )}
    </section>
  );
}

function InventoryDetails({ product, records, onClose, onAdjust }) {
  useEffect(() => {
    const handleKeyDown = (event) => {
      if (event.key === 'Escape') onClose();
    };
    const previousOverflow = document.body.style.overflow;
    document.body.style.overflow = 'hidden';
    document.addEventListener('keydown', handleKeyDown);
    return () => {
      document.body.style.overflow = previousOverflow;
      document.removeEventListener('keydown', handleKeyDown);
    };
  }, [onClose]);

  return (
    <AdminModal
      isOpen={true}
      onClose={onClose}
      title={product.name}
      subtitle="Inventory Details"
      size="lg"
      footer={
        <>
          <button className="admin-btn admin-btn-secondary" onClick={onClose}>Close</button>
          <button className="admin-btn admin-btn-primary" onClick={onAdjust}>Adjust stock</button>
        </>
      }
    >
      <div className="admin-inventory-detail-content">
        <div className="admin-inventory-detail-image">
          {getProductImage(product) ? (
            <img src={resolveImageUrl(getProductImage(product))} alt={product.name} />
          ) : (
            <span className="admin-loading-text">No product image</span>
          )}
        </div>
        <div className="admin-inventory-detail-info">
          <div className="admin-info-row">
            <span>Category</span>
            <strong>{product.category || 'Uncategorized'}</strong>
          </div>
          <div className="admin-info-row">
            <span>Total available units</span>
            <strong>{numberFormat.format(getProductStockTotal(records))}</strong>
          </div>
          <div className="admin-info-row">
            <span>Variants</span>
            <strong>{records.length} color-size combinations</strong>
          </div>
        </div>
      </div>
      <div className="admin-variant-table-wrap">
        <table className="admin-variant-table">
          <thead>
            <tr>
              <th>Color</th>
              <th>Size</th>
              <th>On hand</th>
              <th>Reserved</th>
              <th>Available</th>
              <th>Threshold</th>
              <th>Updated</th>
            </tr>
          </thead>
          <tbody>
            {records.length ? records.map((record) => (
              <tr key={`${record.color || ''}-${record.size || ''}`}>
                <td>{record.color || '—'}</td>
                <td>{record.size || '—'}</td>
                <td>{record.onHandQuantity}</td>
                <td>{record.reservedQuantity}</td>
                <td><strong>{record.availableQuantity}</strong></td>
                <td>{record.lowStockThreshold ?? '—'}</td>
                <td>{formatDate(record.updatedAt)}</td>
              </tr>
            )) : (
              <tr><td colSpan="7">No inventory variants have been created.</td></tr>
            )}
          </tbody>
        </table>
      </div>
    </AdminModal>
  );
}

function StockAdjustmentModal({ product, records, user, onClose, onSaved, onError }) {
  const [color, setColor] = useState('');
  const [size, setSize] = useState('');
  const [stock, setStock] = useState('');
  const [threshold, setThreshold] = useState('');
  const [saving, setSaving] = useState(false);
  const [error, setError] = useState('');

  useEffect(() => {
    const handleKeyDown = (event) => {
      if (event.key === 'Escape') onClose();
    };
    const previousOverflow = document.body.style.overflow;
    document.body.style.overflow = 'hidden';
    document.addEventListener('keydown', handleKeyDown);
    return () => {
      document.body.style.overflow = previousOverflow;
      document.body.style.overflow = previousOverflow;
      document.removeEventListener('keydown', handleKeyDown);
    };
  }, [onClose]);

  const colors = Array.isArray(product.colors) ? product.colors : [];
  const sizes = Array.isArray(product.sizes) ? product.sizes : [];

  const selectedRecord = records.find(
    (record) => (record.color || '') === color && (record.size || '') === size,
  );

  useEffect(() => {
    if (!selectedRecord) {
      setStock('');
      setThreshold('');
      return;
    }
    setStock(String(selectedRecord.onHandQuantity));
    setThreshold(selectedRecord.lowStockThreshold == null ? '' : String(selectedRecord.lowStockThreshold));
  }, [selectedRecord]);

  async function handleSubmit(event) {
    event.preventDefault();
    if (saving) return;
    setError('');
    if (!color || !size) {
      setError('Select both a color and a size.');
      return;
    }
    if (stock === '' || !Number.isInteger(Number(stock)) || Number(stock) < 0) {
      setError('Enter a valid non-negative whole-number stock quantity.');
      return;
    }
    if (threshold !== '' && (!Number.isInteger(Number(threshold)) || Number(threshold) < 0)) {
      setError('Enter a valid non-negative whole-number threshold.');
      return;
    }
    setSaving(true);
    try {
      await adjustInventoryStock(user, {
        productId: product.id,
        color,
        size,
        stock: Number(stock),
        lowStockThreshold: threshold === '' : null : Number(threshold),
      });
      onSaved();
    } catch (requestError) {
      setError(requestError.message || 'Could not save the stock adjustment.');
      onError(requestError.message || 'Could not save the stock adjustment.');
    } finally {
      setSaving(false);
    }
  }

  return (
    <AdminModal
      isOpen={open}
      onClose={onClose}
      title="Adjust stock"
      subtitle={product.name}
      size="md"
      footer={
        <>
          <button className="admin-btn admin-btn-secondary" onClick={onClose} disabled={saving}>Cancel</button>
          <button className="admin-btn admin-btn-primary" onClick={handleSubmit} disabled={saving || !colors.length || !sizes.length}>
            {saving ? 'Saving...' : 'Save stock'}
          </button>
        </>
      }
    >
      <form className="admin-product-form" onSubmit={handleSubmit}>
        <div className="admin-form-grid">
          <div className="admin-form-group">
            <label>Color *</label>
            <select value={color} onChange={(event) => setColor(event.target.value)} required>
              <option value="">Select color</option>
              {colors.map((item) => <option key={item} value={item}>{item}</option>)}
            </select>
          </div>
          <div className="admin-form-group">
            <label>Size *</label>
            <select value={size} onChange={(event) => setSize(event.target.value)} required>
              <option value="">Select size</option>
              <option value="all">All sizes</option>
              {sizes.map((item) => <option key={item} value={item}>{item}</option>)}
            </select>
          </div>
        </div>
        {color && size && (
          <div className="admin-current-stock">
            {selectedRecord ? (
              <>
                <span>Current inventory</span>
              </strong>
                <strong>
                  {selectedRecord.onHandQuantity} on hand ·{' '}
                  {selectedRecord.reservedQuantity} reserved ·{' '}
                  {selectedRecord.availableQuantity} available
                </strong>
              </strong>
            </div>
          )}
        </div>
        <div className="admin-form-group">
          <label>On-hand stock *</label>
          <input type="number" min="0" step="1" value={stock} onChange={(event) => setStock(event.target.value)} required />
          <small className="admin-form-hint">Enter the final physical stock quantity.</small>
        </div>
        <div className="admin-form-group">
          <label>Low-stock threshold</label>
          <input type="number" min="0" step="1" value={threshold} onChange={(event) => setThreshold(event.target.value)} placeholder="Optional" />
          <small className="admin-form-hint">Available stock at or below this value is marked low.</small>
        </div>
        {error && <p className="admin-form-error" role="alert">{error}</p>}
      </form>
    </AdminModal>
  );
}
