
import { useEffect, useMemo, useState } from 'react';
import { useAuth } from '../../context/useAuth.js';
import { fetchAdminOrders, AdminOrdersApiError } from '../../api/adminOrderApi.js';

import AdminPageHeader from '../../components/Admin/AdminPageHeader';
import AdminStatCard from '../../components/Admin/AdminStatCard';
import AdminDataTable from '../../components/Admin/AdminDataTable';
import AdminModal from '../../components/Admin/AdminModal';
import AdminStatusPill from '../../components/Admin/AdminStatusPill';

import './AdminOrders.css';

const PAGE_SIZE = 8;

const money = (value) =>
  new Intl.NumberFormat('en-PH', {
    style: 'currency',
    currency: 'PHP',
    maximumFractionDigits: 2,
  }).format(Number(value) || 0);

const dateTime = (value) => {
  if (!value) return '—';
  const date = new Date(value);
  return Number.isNaN(date.getTime())
    ? '—'
    : new Intl.DateTimeFormat('en-PH', {
        dateStyle: 'medium',
        timeStyle: 'short',
      }).format(date);
};

const label = (value) =>
  String(value || 'Unknown')
    .replaceAll('_', ' ')
    .replaceAll('-', ' ')
    .replace(/\b\w/g, (character) => character.toUpperCase());

const getOrderTotal = (order) =>
  Number(order.subtotal ?? (
    Number(order.readySubtotal || 0) +
    Number(order.preorderSubtotal || 0)
  ));

const getItemCount = (order) =>
  (order.items || []).reduce(
    (total, item) => total + Number(item.quantity || 0),
    0,
  );

export default function AdminOrders() {
  const { user } = useAuth();

  const [orders, setOrders] = useState([]);
  const [status, setStatus] = useState('loading');
  const [error, setError] = useState('');
  const [reloadKey, setReloadKey] = useState(0);

  const [search, setSearch] = useState('');
  const [orderStatus, setOrderStatus] = useState('all');
  const [paymentStatus, setPaymentStatus] = useState('all');
  const [sort, setSort] = useState('newest');
  const [page, setPage] = useState(1);

  const [selectedOrder, setSelectedOrder] = useState(null);

  useEffect(() => {
    if (!user) {
      setStatus('error');
      setError('You must be signed in to view administrative orders.');
      return undefined;
    }

    const controller = new AbortController();
    setStatus('loading');
    setError('');

    fetchAdminOrders(user, { signal: controller.signal })
      .then((data) => {
        setOrders(data);
        setStatus('ready');
      })
      .catch((requestError) => {
        if (requestError?.name === 'AbortError') return;
        setOrders([]);
        if (requestError instanceof AdminOrdersApiError &&
            requestError.kind === 'unavailable') {
          setStatus('unavailable');
        } else {
          setStatus('error');
          setError(requestError.message || 'Could not load orders.');
        }
      });

    return () => controller.abort();
  }, [user, reloadKey]);

  const summary = useMemo(() => ({
    total: orders.length,
    pending: orders.filter((order) =>
      ['awaiting_payment', 'pending'].includes(order.orderStatus),
    ).length,
    processing: orders.filter((order) =>
      ['processing', 'ready_for_shipment'].includes(order.orderStatus),
    ).length,
    completed: orders.filter((order) =>
      order.orderStatus === 'completed',
    ).length,
    cancelled: orders.filter((order) =>
      order.orderStatus === 'cancelled',
    ).length,
  }), [orders]);

  const filteredOrders = useMemo(() => {
    const query = search.trim().toLowerCase();

    const filtered = orders.filter((order) => {
      const matchesSearch = !query || [
        order.orderCode,
        order.customerFullName,
        order.customerEmail,
      ].some((value) => String(value || '').toLowerCase().includes(query));

      const matchesOrderStatus =
        orderStatus === 'all' || order.orderStatus === orderStatus;

      const matchesPaymentStatus =
        paymentStatus === 'all' || order.paymentStatus === paymentStatus;

      return matchesSearch && matchesOrderStatus && matchesPaymentStatus;
    });

    return filtered.sort((a, b) => {
      const first = new Date(a.createdAt || 0).getTime();
      const second = new Date(b.createdAt || 0).getTime();
      return sort === 'oldest' ? first - second : second - first;
    });
  }, [orders, search, orderStatus, paymentStatus, sort]);

  const totalPages = Math.max(1, Math.ceil(filteredOrders.length / PAGE_SIZE));
  const currentPage = Math.min(page, totalPages);
  const pageOrders = filteredOrders.slice(
    (currentPage - 1) * PAGE_SIZE,
    currentPage * PAGE_SIZE,
  );

  function updateFilter(setter, value) {
    setter(value);
    setPage(1);
  }

  function clearFilters() {
    setSearch('');
    setOrderStatus('all');
    setPaymentStatus('all');
    setSort('newest');
    setPage(1);
  }

  function reload() {
    setSelectedOrder(null);
    setReloadKey((value) => value + 1);
  }

  const tableColumns = [
    { label: 'Order', className: 'col-order' },
    { label: 'Customer', className: 'col-customer' },
    { label: 'Date', className: 'col-date' },
    { label: 'Items', className: 'col-items' },
    { label: 'Total', className: 'col-total' },
    { label: 'Payment', className: 'col-payment' },
    { label: 'Order status', className: 'col-status' },
    { label: 'Actions', className: 'col-actions' },
  ];

  const renderOrderRow = (order) => (
    <>
      <td>
        <div className="admin-order-cell">
          <strong className="admin-order-code">{order.orderCode || '—'}</strong>
          {order.isTest && <small className="admin-test-label">Test order</small>}
        </div>
      </td>
      <td>
        <div className="admin-customer-cell">
          <strong>{order.customerFullName || 'Unknown customer'}</strong>
          <small>{order.customerEmail || '—'}</small>
        </div>
      </td>
      <td>{dateTime(order.createdAt)}</td>
      <td>{getItemCount(order)}</td>
      <td className="admin-order-total">{money(getOrderTotal(order))}</td>
      <td>
        <AdminStatusPill status={order.paymentStatus === 'verified' ? 'Verified' : order.paymentStatus === 'rejected' ? 'Rejected' : 'Pending'} />
      </td>
      <td>
        <AdminStatusPill status={order.orderStatus === 'completed' ? 'Verified' : order.orderStatus === 'cancelled' ? 'Rejected' : 'Pending'} />
      </td>
      <td>
        <div className="admin-row-actions">
          <button className="admin-btn admin-btn-ghost" onClick={() => setSelectedOrder(order)}>View details</button>
        </div>
      </td>
    </>
  );

  return (
    <section className="admin-orders">
      <AdminPageHeader
        eyebrow="STORE MANAGEMENT"
        title="Orders"
        description="Review customer orders and monitor their progress."
        action={
          <button className="admin-btn admin-btn-secondary" onClick={reload} disabled={status === 'loading'}>
            ↻ Refresh orders
          </button>
        }
      />

      {status === 'unavailable' && (
        <div className="admin-action-notice" role="alert">
          <span className="admin-action-notice-text">
            <strong>Admin orders API is not connected yet.</strong> The interface is ready, but the backend needs a dedicated Owner/Admin endpoint before it can retrieve the store's orders.
          </span>
        </div>
      )}

      {status === 'error' && (
        <div className="admin-action-notice admin-notice-error" role="alert">
          <span className="admin-action-notice-text">
            <strong>Orders could not be loaded.</strong> {error}
            <button className="admin-btn admin-btn-ghost" onClick={reload} style={{ marginLeft: '12px' }}>Try again</button>
          </span>
        </div>
      )}

      <div className="admin-summary-grid">
        <AdminStatCard label="Total orders" value={status === 'ready' ? summary.total : '—'} description="All recorded orders" />
        <AdminStatCard label="Pending orders" value={status === 'ready' ? summary.pending : '—'} description="Awaiting payment or action" />
        <AdminStatCard label="Processing" value={status === 'ready' ? summary.processing : '—'} description="Being prepared for delivery" />
        <AdminStatCard label="Completed" value={status === 'ready' ? summary.completed : '—'} description="Successfully completed" />
      </div>

      <div className="admin-orders-secondary-summary">
        <span>Cancelled orders: <strong className="admin-orders-cancelled">{status === 'ready' ? summary.cancelled : '—'}</strong></span>
        <span className="admin-orders-footer-note">Displaying actual order records only</span>
      </div>

      <section className="admin-catalog-panel">
        <div className="admin-catalog-header">
          <div className="admin-catalog-title-group">
            <h2 className="admin-catalog-title">All orders</h2>
            <p className="admin-catalog-description">Search, filter, and review customer orders.</p>
          </div>
          <span className="admin-result-count">
            {status === 'ready' ? filteredOrders.length : '—'} orders
          </span>
        </div>

        <div className="admin-toolbar">
          <div className="admin-search-box">
            <span className="admin-search-icon">⌕</span>
            <input
              type="search"
              value={search}
              onChange={(event) => updateFilter(setSearch, event.target.value)}
              placeholder="Search order ID or customer..."
              aria-label="Search orders"
              disabled={status !== 'ready'}
            />
          </div>
          <div className="admin-filter-group">
            <label className="admin-filter">
              <span>Order status</span>
              <select value={orderStatus} onChange={(event) => updateFilter(setOrderStatus, event.target.value)} disabled={status !== 'ready'}>
                <option value="all">All statuses</option>
                {['awaiting_payment', 'processing', 'ready_for_shipment', 'shipped', 'completed', 'cancelled'].map((item) => <option key={item} value={item}>{label(item)}</option>)}
              </select>
            </label>
            <label className="admin-filter">
              <span>Payment status</span>
              <select value={paymentStatus} onChange={(event) => updateFilter(setPaymentStatus, event.target.value)} disabled={status !== 'ready'}>
                <option value="all">All payments</option>
                {['awaiting_submission', 'pending_verification', 'verified', 'rejected'].map((item) => <option key={item} value={item}>{label(item)}</option>)}
              </select>
            </label>
            <label className="admin-filter">
              <span>Sort by</span>
              <select value={sort} onChange={(event) => updateFilter(setSort, event.target.value)} disabled={status !== 'ready'}>
                <option value="newest">Newest first</option>
                <option value="oldest">Oldest first</option>
              </select>
            </label>
            <button className="admin-btn admin-btn-ghost" onClick={clearFilters} disabled={status !== 'ready'}>Clear filters</button>
          </div>
        </div>

        <AdminDataTable
          columns={tableColumns}
          data={pageOrders}
          renderRow={renderOrderRow}
          loadingState={status === 'loading' ? "Loading orders..." : null}
          errorState={status === 'error' ? `Unable to display orders: ${error}` : null}
          emptyState={
            <div className="admin-table-empty-content">
              <span className="admin-empty-icon">▤</span>
              <strong>No orders found</strong>
              <p>Try changing your search or filters.</p>
              <button className="admin-btn admin-btn-secondary" onClick={clearFilters}>Clear filters</button>
            </div>
          }
        />

        <div className="admin-pagination">
          <span className="admin-pagination-info">
            Showing {(currentPage - 1) * PAGE_SIZE + 1}–{Math.min(currentPage * PAGE_SIZE, filteredOrders.length)} of {filteredOrders.length} orders
          </span>
          <div className="admin-pagination-controls">
            <button className="admin-btn admin-btn-ghost" disabled={currentPage <= 1} onClick={() => setPage((v) => v - 1)}>Previous</button>
            <span className="admin-pagination-current">Page {currentPage} of {totalPages}</span>
            <button className="admin-btn admin-btn-ghost" disabled={currentPage >= totalPages} onClick={() => setPage((v) => v + 1)}>Next</button>
          </div>
        </div>
      </section>

      {selectedOrder && (
        <OrderDetails
          order={selectedOrder}
          onClose={() => setSelectedOrder(null)}
        />
      )}
    </section>
  );
}

function OrderDetails({ order, onClose }) {
  useEffect(() => {
    const handleKeyDown = (event) => {
      if (event.key === 'Escape') onClose();
    };
    window.addEventListener('keydown', handleKeyDown);
    return () => window.removeEventListener('keydown', handleKeyDown);
  }, [onClose]);

  const address = [
    order.streetAddress,
    order.barangay,
    order.cityMunicipality,
    order.province,
    order.postalCode,
  ].filter(Boolean).join(', ');

  return (
    <AdminModal
      isOpen={true}
      onClose={onClose}
      title={order.orderCode || 'Order details'}
      subtitle={`Placed ${dateTime(order.createdAt)}`}
      size="lg"
      footer={
        <button className="admin-btn admin-btn-secondary" onClick={onClose}>Close</button>
      }
    >
      <div className="admin-order-detail-content">
        <section className="admin-detail-section">
          <h3 className="admin-section-title">Order status</h3>
          <div className="admin-status-overview">
            <div className="admin-status-item">
              <span className="admin-status-label">Order</span>
              <AdminStatusPill status={order.orderStatus === 'completed' ? 'Verified' : order.orderStatus === 'cancelled' ? 'Rejected' : 'Pending'} />
            </div>
            <div className="admin-status-item">
              <span className="admin-status-label">Payment</span>
              <AdminStatusPill status={order.paymentStatus === 'verified' ? 'Verified' : order.paymentStatus === 'rejected' ? 'Rejected' : 'Pending'} />
            </div>
          </div>
        </section>

        <section className="admin-detail-section">
          <h3 className="admin-section-title">Customer information</h3>
          <div className="admin-info-row">
            <span>Full name</span>
            <strong>{order.customerFullName}</strong>
          </div>
          <div className="admin-info-row">
            <span>Email</span>
            <strong>{order.customerEmail}</strong>
          </div>
          <div className="admin-info-row">
            <span>Mobile</span>
            <strong>{order.mobileNumber}</strong>
          </div>
        </section>

        <section className="admin-detail-section">
          <h3 className="admin-section-title">Delivery information</h3>
          <div className="admin-info-row">
            <span>Address</span>
            <strong>{address}</strong>
          </div>
          <div className="admin-info-row">
            <span>Delivery notes</span>
            <strong>{order.deliveryNotes}</strong>
          </div>
        </section>

        <section className="admin-detail-section">
          <h3 className="admin-section-title">Ordered products</h3>
          {(order.items || []).length === 0 ? (
            <p className="admin-muted">No item details were returned.</p>
          ) : (
            <div className="admin-items-list">
              {order.items.map((item, index) => (
                <article className="admin-item">
                  <div className="admin-item-info">
                    <strong className="admin-item-name">{item.productName}</strong>
                    <span className="admin-item-meta">
                      {item.size ? `Size ${item.size} · ` : ''}
                      {label(item.fulfillmentStatus)} · Qty {item.quantity}
                    </span>
                  </div>
                  <strong className="admin-item-total">{money(item.lineTotal)}</strong>
                </article>
              ))}
            </div>
          )}
        </section>

        <section className="admin-detail-section">
          <h3 className="admin-section-title">Peyment breakdown</h3>
          <div className="admin-info-row">
            <span>Ready subtotal</span>
            <strong>{money(order.readySubtotal)}</strong>
          </div>
          <div className="admin-info-row">
            <span>Pre-order subtotal</strong>
            <strong>{money(order.preorderSubtotal)}</strong>
          </div>
          <div className="admin-info-row">
            <span>Deposit</span>
            <strong>{Number(order.depositPercent || 0)}%</strong>
          </div>
          <div className="admin-info-row">
            <span>L deposit amount</strong>
            <strong>{money(order.depositAmount)}</strong>
          </div>
          <div className="admin-info-row">
            <span>Due today</span>
            <strong>{money(order.dueToday)}</strong>
          </div>
          <div className="admin-info-row">
            <span>Remaining balance</span>
            <strong>{money(order.balanceLater)}</strong>
          </div>
          <div className="admin-total-row">
            <span>Order subtotal</span>
            <strong>{money(getOrderTotal(order))}</strong>
          </div>
        </section>

        <section className="admin-detail-section">
          <h3 className="admin-section-title">Payment submissions</h3>
          {(order.payments || []).length === 0 ? (
            <p className="admin-muted">No payment submissions recorded.</p>
          ) : (
            order.payments.map((payment) => (
              <article className="admin-payment">
                <div className="admin-payment-info">
                  <strong className="admin-payment-title">{label(payment.paymentPurpose)}</strong>
                  <span className="admin-payment-meta">
                    {label(payment.paymentMethod)} · {dateTime(payment.submittedAt)}
                  </span>
                  <span className="admin-payment-ref">Reference: {payment.referenceNumber || '—'}</span>
                </div>
                <div className="admin-payment-amount-group">
                  <strong className="admin-payment-total">{money(payment.amount)}</strong>
                  <AdminStatusPill status={payment.status === 'verified' ? 'Verified' : payment.status === 'rejected' ? 'Rejected' : 'Pending'} />
                </div>
              </article>
            ))
          })
        </section>

        <section className="admin-detail-section">
          <h3 className="admin-section-title">Order status history</h3>
          <div className="admin-timeline">
            {(order.events || []).length === 0 ? (
              <p className="admin-muted">No status history available.</p>
            ) : (
              order.events.map((event) => (
                <div className="admin-timeline-item">
                  <div className="admin-timeline-dot" />
                  <div className="admin-timeline-content">
                    <strong className="admin-timeline-title">{label(event.newStatus)}</strong>
                    <p className="admin-timeline-desc">
                      {event.previousStatus ? `${label(event.previousStatus)} → ${label(event.newStatus)}` : 'Initial order status'}
                    </p>
                    {event.note && <p className="admin-timeline-note">{event.note}</p>}
                    <small className="admin-timeline-meta">
                      {dateTime(event.createdAt)} · {event.changedBy || 'System'}
                    </small>
                  </div>
                </div>
              ))
            })
          </section>

        <p className="admin-detail-footnote">
          This view is read-only. Order actions, payment verification, and shipment management require separate authorized backend operations.
        </p>
      </div>
    </AdminModal>
  );
}
