
.admin-products {
  width: 100%;
}

.admin-summary-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 20px;
  margin-bottom: 40px;
}

.admin-catalog-panel {
  background: var(--admin-surface);
  border: 1px solid var(--admin-border);
  border-radius: var(--admin-radius-md);
  padding: 24px;
  box-shadow: var(--admin-shadow-sm);
}

.admin-catalog-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24px;
}

.admin-catalog-title-group {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.admin-catalog-title {
  font-size: 18px;
  font-weight: 600;
  color: var(--admin-text-primary);
  margin: 0;
}

.admin-catalog-description {
  font-size: 14px;
  color: var(--admin-text-secondary);
  margin: 0;
}

.admin-result-count {
  font-size: 12px;
  color: var(--admin-text-secondary);
  background: var(--admin-bg);
  padding: 4px 10px;
  border-radius: 10px;
}

.admin-toolbar {
  display: flex;
  gap: 20px;
  margin-bottom: 24px;
  flex-wrap: wrap;
}

.admin-search-box {
  position: relative;
  flex: 1;
  min-width: 250px;
}

.admin-search-icon {
  position: absolute;
  left: 12px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--admin-text-secondary);
  font-size: 14px;
}

.admin-search-box input {
  width: 100%;
  padding: 8px 12px 8px 36px;
  border: 1px solid var(--admin-border);
  border-radius: var(--admin-radius-sm);
  font-size: 13px;
  font-family: inherit;
  transition: var(--admin-transition);
}

.admin-search-box input:focus {
  outline: none;
  border-color: var(--admin-accent);
}

.admin-filter-group {
  display: flex;
  gap: 12px;
}

.admin-filter {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.admin-filter span {
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  color: var(--admin-text-secondary);
}

.admin-filter select {
  padding: 8px 12px;
  border: 1px solid var(--admin-border);
  border-radius: var(--admin-radius-sm);
  font-size: 13px;
  background: white;
  min-width: 120px;
  cursor: pointer;
}

.admin-product-cell {
  display: flex;
  align-items: center;
  gap: 12px;
}

.admin-product-thumb {
  display: grid;
  place-items: center;
  width: 40px;
  height: 40px;
  border-radius: var(--admin-radius-sm);
  background: var(--admin-bg);
  overflow: hidden;
  flex-shrink: 0;
}

.admin-product-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.admin-product-info {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.admin-product-info strong {
  font-size: 13px;
  color: var(--admin-text-primary);
}

.admin-product-info small {
  font-size: 11px;
  color: var(--admin-text-secondary);
}

.admin-category-label {
  font-size: 12px;
  color: var(--admin-text-secondary);
}

.admin-listing-status {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
}

.admin-listing-status.active {
  color: var(--admin-success-text);
}

.admin-listing-status.inactive {
  color: var(--admin-danger-text);
}

.admin-listing-status .admin-status-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
}

.admin-listing-status.active .admin-status-dot {
  background: var(--admin-success-text);
}

.admin-listing-status.inactive .admin-status-dot {
  background: var(--admin-danger-text);
}

.admin-row-actions {
  display: flex;
  gap: 8px;
}

.admin-pagination {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24px;
}

.admin-pagination-info {
  font-size: 13px;
  color: var(--admin-text-secondary);
}

.admin-pagination-controls {
  display: flex;
  align-items: center;
  gap: 16px;
}

.admin-pagination-current {
  font-size: 13px;
  font-weight: 500;
}

.admin-action-notice {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px;
  background: var(--admin-surface);
  border: 1px solid var(--admin-border);
  border-left: 4px solid var(--admin-accent);
  border-radius: var(--admin-radius-sm);
  margin-bottom: 24px;
}

.admin-action-notice-text {
  font-size: 13px;
  color: var(--admin-text-primary);
}

/* Product Details & Form */

.admin-product-detail-content {
  display: grid;
  grid-template-columns: 300px 1fr;
  gap: 32px;
}

.admin-product-detail-image img {
  width: 100%;
  border-radius: var(--admin-radius-md);
  border: 1px solid var(--admin-border);
}

.admin-info-row {
  display: flex;
  justify-content: space-between;
  padding: 12px 0;
  border-bottom: 1px solid var(--admin-border);
}

.admin-info-row:last-child {
  border-bottom: 0;
}

.admin-info-row span {
  color: var(--admin-text-secondary);
  font-size: 13px;
}

.admin-info-row strong {
  color: var(--admin-text-primary);
  font-size: 13px;
}

.admin-product-form {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.admin-form-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
}

.admin-form-group {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.admin-form-group label {
  font-size: 12px;
  font-weight: 600;
  color: var(--admin-text-secondary);
}

.admin-form-group input,
.admin-form-group select {
  padding: 8px 12px;
  border: 1px solid var(--admin-border);
  border-radius: var(--admin-radius-sm);
  font-size: 13px;
  font-family: inherit;
}

.admin-form-full {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.admin-form-full label {
  font-size: 12px;
  font-weight: 600;
  color: var(--admin-text-secondary);
}

.admin-form-full input {
  padding: 8px 12px;
  border: 1px solid var(--admin-border);
  border-radius: var(--admin-radius-sm);
  font-size: 13px;
  font-family: inherit;
}

.admin-form-hint {
  font-size: 11px;
  color: var(--admin-text-secondary);
  margin-top: 4px;
}

.admin-checkbox-label {
  font-size: 13px;
  color: var(--admin-text-primary);
  margin-left: 8px;
}

.admin-image-upload-section {
  border: 1px solid var(--admin-border);
  border-radius: var(--admin-radius-md);
  padding: 20px;
  background: var(--admin-bg);
}

.admin-image-upload-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16px;
}

.admin-image-upload-title-group {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.admin-image-upload-title-group strong {
  font-size: 14px;
  color: var(--admin-text-primary);
}

.admin-image-upload-title-group p {
  font-size: 12px;
  color: var(--admin-text-secondary);
  margin: 0;
}

.admin-image-upload-count {
  font-size: 11px;
  font-weight: 600;
  color: var(--admin-text-secondary);
}

.admin-image-upload-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
  padding: 32px;
  border: 2px dashed var(--admin-border);
  border-radius: var(--admin-radius-md);
  background: var(--admin-surface);
  cursor: pointer;
  transition: var(--admin-transition);
  text-align: center;
}

.admin-image-upload-area:hover {
  border-color: var(--admin-accent);
  background: var(--admin-bg);
}

.admin-image-upload-area.is-dragging {
  border-color: var(--admin-accent);
  background: var(--admin-bg);
}

.admin-image-upload-area.is-disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.admin-image-upload-area input {
  display: none;
}

.admin-image-upload-icon {
  font-size: 32px;
  color: var(--admin-text-secondary);
}

.admin-image-upload-area strong {
  font-size: 14px;
  color: var(--admin-text-primary);
}

.admin-image-upload-area small {
  font-size: 11px;
  color: var(--admin-text-secondary);
}

.admin-image-upload-error {
  margin-top: 12px;
  font-size: 12px;
  color: var(--admin-danger-text);
  text-align: center;
}

.admin-image-preview-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
  gap: 12px;
  margin-top: 20px;
}

.admin-uploaded-image {
  position: relative;
  aspect-ratio: 1;
  border-radius: var(--admin-radius-sm);
  border: 1px solid var(--admin-border);
  overflow: hidden;
  background: white;
}

.admin-uploaded-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.admin-main-image-label {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  background: var(--admin-accent);
  color: white;
  font-size: 9px;
  text-align: center;
  padding: 2px 0;
  font-weight: 600;
}

.admin-initial-stock-section {
  border: 1px solid var(--admin-border);
  border-radius: var(--admin-radius-md);
  padding: 20px;
  background: var(--admin-surface);
}

.admin-initial-stock-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}

.admin-initial-stock-title-group {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.admin-initial-stock-title-group strong {
  font-size: 14px;
  color: var(--admin-text-primary);
}

.admin-initial-stock-title-group p {
  font-size: 12px;
  color: var(--admin-text-secondary);
  margin: 0;
}

.admin-initial-stock-count {
  font-size: 11px;
  font-weight: 600;
  color: var(--admin-text-secondary);
}

.admin-initial-stock-table-wrap {
  overflow-x: auto;
}

.admin-initial-stock-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
}

.admin-initial-stock-table th {
  text-align: left;
  padding: 8px;
  border-bottom: 1px solid var(--admin-border);
  color: var(--admin-text-secondary);
  font-size: 11px;
  text-transform: uppercase;
}

.admin-initial-stock-table td {
  padding: 8px;
  border-bottom: 1px solid var(--admin-border);
}

.admin-initial-stock-table input {
  width: 80px;
  padding: 4px 8px;
  border: 1px solid var(--admin-border);
  border-radius: var(--admin-radius-sm);
}

.admin-form-error {
  padding: 12px;
  background: var(--admin-danger);
  color: var(--admin-danger-text);
  font-size: 13px;
  border-radius: var(--admin-radius-sm);
  text-align: center;
}

@media (max-width: 900px) {
  .admin-form-grid {
    grid-template-columns: 1fr;
  }
  .admin-product-detail-content {
    grid-template-columns: 1fr;
  }
  .admin-product-detail-image img {
    max-height: 300px;
    object-fit: contain;
  }
}
