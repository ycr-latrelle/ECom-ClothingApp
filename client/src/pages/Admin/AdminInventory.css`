
.admin-inventory {
  width: 100%;
}

.admin-summary-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 20px;
  margin-bottom: 40px;
}

.admin-catalog-panel {
  background: var(--admin-surface);
  border: 1px solid var(--admin-border);
  border-radius: var(--admin-radius-md);
  padding: 24px;
  box-shadow: var(--admin-shadow-sm);
}

.admin-catalog-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24px;
}

.admin-catalog-title-group {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.admin-catalog-title {
  font-size: 18px;
  font-weight: 600;
  color: var(--admin-text-primary);
  margin: 0;
}

.admin-catalog-description {
  font-size: 14px;
  color: var(--admin-text-secondary);
  margin: 0;
}

.admin-result-count {
  font-size: 12px;
  color: var(--admin-text-secondary);
  background: var(--admin-bg);
  padding: 4px 10px;
  border-radius: 10px;
}

.admin-toolbar {
  display: flex;
  gap: 20px;
  margin-bottom: 24px;
  flex-wrap: wrap;
}

.admin-search-box {
  position: relative;
  flex: 1;
  min-width: 250px;
}

.admin-search-icon {
  position: absolute;
  left: 12px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--admin-text-secondary);
  font-size: 14px;
}

.admin-search-box input {
  width: 100%;
  padding: 8px 12px 8px 36px;
  border: 1px solid var(--admin-border);
  border-radius: var(--admin-radius-sm);
  font-size: 13px;
  font-family: inherit;
  transition: var(--admin-transition);
}

.admin-search-box input:focus {
  outline: none;
  border-color: var(--admin-accent);
}

.admin-filter-group {
  display: flex;
  gap: 12px;
}

.admin-filter {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.admin-filter span {
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  color: var(--admin-text-secondary);
}

.admin-filter select {
  padding: 8px 12px;
  border: 1px solid var(--admin-border);
  border-radius: var(--admin-radius-sm);
  font-size: 13px;
  background: white;
  min-width: 120px;
  cursor: pointer;
}

.admin-product-cell {
  display: flex;
  align-items: center;
  gap: 12px;
}

.admin-product-thumb {
  display: grid;
  place-items: center;
  width: 40px;
  height: 40px;
  border-radius: var(--admin-radius-sm);
  background: var(--admin-bg);
  overflow: hidden;
  flex-shrink: 0;
}

.admin-product-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.admin-product-info {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.admin-product-info strong {
  font-size: 13px;
  color: var(--admin-text-primary);
}

.admin-product-info small {
  font-size: 11px;
  color: var(--admin-text-secondary);
}

.admin-stock-value {
  font-weight: 600;
  color: var(--admin-text-primary);
}

.admin-inv-status-container {
  display: inline-flex;
}

.admin-product-status-group {
  display: flex;
  gap: 8px;
  align-items: center;
}

.admin-listing-status {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
}

.admin-listing-status.active {
  color: var(--admin-success-text);
}

.admin-listing-status.inactive {
  color: var(--admin-danger-text);
}

.admin-listing-status .admin-status-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
}

.admin-listing-status.active .admin-status-dot {
  background: var(--admin-success-text);
}

.admin-listing-status.inactive .admin-status-dot {
  background: var(--admin-danger-text);
}

.admin-row-actions {
  display: flex;
  gap: 8px;
}

.admin-pagination {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24px;
}

.admin-pagination-info {
  font-size: 13px;
  color: var(--admin-text-secondary);
}

.admin-pagination-controls {
  display: flex;
  align-items: center;
  gap: 16px;
}

.admin-pagination-current {
  font-size: 13px;
  font-weight: 500;
}

.admin-action-notice {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px;
  background: var(--admin-surface);
  border: 1px solid var(--admin-border);
  border-left: 4px solid var(--admin-accent);
  border-radius: var(--admin-radius-sm);
  margin-bottom: 24px;
}

.admin-action-notice-text {
  font-size: 13px;
  color: var(--admin-text-primary);
}

.admin-notice-error {
  border-left-color: var(--admin-danger);
  background: var(--admin-danger);
  color: var(--admin-danger-text);
}

/* Inventory Detail View */

.admin-inventory-detail-content {
  display: grid;
  grid-template-columns: 300px 1fr;
  gap: 32px;
}

.admin-inventory-detail-image img {
  width: 100%;
  border-radius: var(--admin-radius-md);
  border: 1px solid var(--admin-border);
}

.admin-info-row {
  display: flex;
  justify-content: space-between;
  padding: 12px 0;
  border-bottom: 1px solid var(--admin-border);
}

.admin-info-row:last-child {
  border-bottom: 0;
}

.admin-info-row span {
  color: var(--admin-text-secondary);
  font-size: 13px;
}

.admin-info-row strong {
  color: var(--admin-text-primary);
  font-size: 13px;
}

.admin-variant-table-wrap {
  margin-top: 24px;
  width: 100%;
  overflow-x: auto;
}

.admin-variant-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
}

.admin-variant-table th {
  text-align: left;
  padding: 12px 10px;
  border-bottom: 1px solid var(--admin-border);
  color: var(--admin-text-secondary);
  font-size: 11px;
  text-transform: uppercase;
}

.admin-variant-table td {
  padding: 12px 10px;
  border-bottom: 1px solid var(--admin-border);
  color: var(--admin-text-primary);
}

/* Stock Adjustment Form */

.admin-current-stock {
  display: grid;
  gap: 6px;
  padding: 12px;
  border: 1px solid var(--admin-border);
  border-radius: var(--admin-radius-sm);
  background: var(--admin-bg);
  color: var(--admin-text-secondary);
  font-size: 12px;
}

.admin-current-stock strong {
  color: var(--admin-text-primary);
  font-size: 13px;
}

.admin-form-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px;
}

.admin-form-group {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.admin-form-group label {
  font-size: 12px;
  font-weight: 600;
  color: var(--admin-text-secondary);
}

.admin-form-group input,
.admin-form-group select {
  padding: 8px 12px;
  border: 1px solid var(--admin-border);
  border-radius: var(--admin-radius-sm);
  font-size: 13px;
  font-family: inherit;
}

.admin-form-hint {
  font-size: 11px;
  color: var(--admin-text-secondary);
  margin-top: 4px;
}

.admin-form-error {
  padding: 12px;
  background: var(--admin-danger);
  color: var(--admin-danger-text);
  font-size: 13px;
  border-radius: var(--admin-radius-sm);
  text-align: center;
}

@media (max-width: 900px) {
  .admin-form-grid {
    grid-template-columns: 1fr;
  }
  .admin-inventory-detail-content {
    grid-template-columns: 1fr;
  }
}
