
.admin-orders {
  width: 100%;
}

.admin-orders-secondary-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 8px 12px;
  margin: 0 0 24px;
  color: var(--admin-text-secondary);
  font-size: 12px;
}

.admin-orders-cancelled {
  color: var(--admin-text-primary);
  font-weight: 600;
}

.admin-orders-footer-note {
  font-style: italic;
  opacity: 0.8;
}

.admin-order-cell {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.admin-order-code {
  display: block;
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  font-size: 11px;
  font-weight: 600;
  color: var(--admin-text-primary);
}

.admin-test-label {
  display: inline-block;
  padding: 2px 6px;
  border-radius: 3px;
  background: #fff4dc;
  color: #9a6a00;
  font-size: 9px;
  font-weight: 600;
}

.admin-customer-cell {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.admin-customer-cell strong {
  font-size: 13px;
  color: var(--admin-text-primary);
}

.admin-customer-cell small {
  font-size: 11px;
  color: var(--admin-text-secondary);
}

.admin-order-total {
  font-weight: 600;
  color: var(--admin-text-primary);
}

.admin-notice-error {
  border-left-color: var(--admin-danger);
  background: var(--admin-danger);
  color: var(--admin-danger-text);
}

/* Order Detail Modal */

.admin-order-detail-content {
  display: flex;
  flex-direction: column;
  gap: 32px;
}

.admin-detail-section {
  display: grid;
  gap: 12px;
  padding-bottom: 24px;
  border-bottom: 1px solid var(--admin-border);
}

.admin-detail-section:last-child {
  border-bottom: 0;
}

.admin-status-overview {
  display: flex;
  flex-wrap: wrap;
  gap: 24px;
}

.admin-status-item {
  display: grid;
  gap: 6px;
  color: var(--admin-text-secondary);
  font-size: 12px;
}

.admin-info-row {
  display: flex;
  justify-content: space-between;
  padding: 10px 0;
  border-bottom: 1px solid var(--admin-border);
}

.admin-info-row:last-child {
  border-bottom: 0;
}

.admin-info-row span {
  color: var(--admin-text-secondary);
  font-size: 13px;
}

.admin-info-row strong {
  color: var(--admin-text-primary);
  font-size: 13px;
}

.admin-items-list {
  display: grid;
  gap: 12px;
}

.admin-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px;
  border: 1px solid var(--admin-border);
  border-radius: var(--admin-radius-sm);
  background: var(--admin-bg);
  font-size: 13px;
}

.admin-item-info {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.admin-item-name {
  font-weight: 600;
  color: var(--admin-text-primary);
}

.admin-item-meta {
  font-size: 11px;
  color: var(--admin-text-secondary);
}

.admin-item-total {
  font-weight: 600;
  color: var(--admin-text-primary);
}

.admin-total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px;
  background: var(--admin-bg);
  border-radius: var(--admin-radius-sm);
  margin-top: 12px;
  font-weight: 700;
  color: var(--admin-text-primary);
}

.admin-payment {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px;
  border: 1px solid var(--admin-border);
  border-radius: var(--admin-radius-sm);
  background: var(--admin-surface);
  margin-bottom: 8px;
}

.admin-payment-info {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.admin-payment-title {
  font-weight: 600;
  }

.admin-payment-meta {
  font-size: 11px;
  color: var(--admin-text-secondary);
}

.admin-payment-ref {
  font-size: 11px;
  color: var(--admin-text-secondary);
}

.admin-payment-amount-group {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4px;
}

.admin-payment-total {
  font-weight: 600;
}

.admin-timeline {
  position: relative;
  display: grid;
  gap: 20px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.admin-timeline-item {
  display: flex;
  gap: 16px;
  position: relative;
}

.admin-timeline-item:not(:last-child)::before {
  content: "";
  position: absolute;
  top: 14px;
  bottom: -20px;
  left: 6px;
  width: 1px;
  background: var(--admin-border);
}

.admin-timeline-dot {
  width: 10px;
  height: 10px;
  background: var(--admin-accent);
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 4px;
  z-index: 1;
}

.admin-timeline-content {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.admin-timeline-title {
  font-size: 13px;
  font-weight: 600;
  color: var(--admin-text-primary);
}

.admin-timeline-desc {
  font-size: 12px;
  color: var(--admin-text-secondary);
}

.admin-timeline-note {
  font-size: 12px;
  color: var(--admin-text-primary);
  font-style: italic;
}

.admin-timeline-meta {
  font-size: 11px;
  color: var(--admin-text-secondary);
  margin-top: 4px;
}

.admin-detail-footnote {
  font-size: 11px;
  color: var(--admin-text-secondary);
  text-align: center;
  margin-top: 24px;
  opacity: 0.8;
}
