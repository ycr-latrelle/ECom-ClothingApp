
import React from 'react';
import './AdminDataTable.css';

export default function AdminDataTable({
  columns,
  data,
  renderRow,
  emptyState,
  loadingState,
  errorState
}) {
  if (loadingState) return <div className="admin-table-loading">{loadingState}</div>;
  if (errorState) return <div className="admin-table-error">{errorState}</div>;
  if (!data || data.length === 0) return <div className="admin-table-empty">{emptyState || 'No data available'}</div>;

  return (
    <div className="admin-table-container">
      <div className="admin-table-wrapper">
        <table className="admin-data-table">
          <thead>
            <tr>
              {columns.map((col, idx) => (
                <th key={idx} className={col.className || ''}>{col.label}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {data.map((item, idx) => (
              <tr key={item.id || idx}>
                {renderRow(item)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  );
}
